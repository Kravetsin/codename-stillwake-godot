<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AssemblyName>Stillwake.Game</AssemblyName>
    <RootNamespace>Stillwake.Game</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A desk build is 0.0.0; CI sets a release's from its tag (docs/releasing.md). -->
    <Version>0.0.0</Version>
    <Version Condition="'$(STILLWAKE_VERSION)' != ''">$(STILLWAKE_VERSION)</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../sim/Registry/Registry.csproj" />
    <ProjectReference Include="../net/Net/Net.csproj" />
  </ItemGroup>
  <!-- Demos are cheats in effect: a release build has none (game/dev/demos/README.md). CI builds this too. -->
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="dev/demos/**;**/*Demo.cs" />
  </ItemGroup>
</Project>
