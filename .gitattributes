# LF everywhere, so Windows and Linux checkouts produce no line-ending diffs.
* text=auto eol=lf

*.png binary
*.webp binary
*.jpg binary
*.ogg binary
*.wav binary
*.woff2 binary
*.cmd text eol=crlf

# Appended rows from two branches both kept; DocsGuardTests catches an order the generator would not write.
docs/decisions/index.md merge=union
