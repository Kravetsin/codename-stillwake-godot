<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- A module's names (CLAUDE.md), so its csproj holds only its references; Core, Content and Registry set their own. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Tests' and '$(MSBuildProjectName)' != 'Analyzers'">
    <AssemblyName>Stillwake.Sim.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Stillwake.Sim.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(MSBuildProjectName)' != 'Analyzers'">
    <InternalsVisibleTo Include="Stillwake.Sim.Tests" />
  </ItemGroup>
  <!-- Determinism (CLAUDE.md): what may differ between machines or runs is banned in the sim. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(MSBuildProjectName)' != 'Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Analyzers/Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
